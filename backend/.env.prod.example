SPRING_PROFILES_ACTIVE=prod
RAILPACK_JDK_VERSION=21
RAILPACK_START_CMD=java -jar target/forma-api-0.0.1-SNAPSHOT.jar
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-internal-host:5432/forma
SPRING_DATASOURCE_USERNAME=replace-with-coolify-postgres-user
SPRING_DATASOURCE_PASSWORD=replace-with-coolify-postgres-password
FORMA_API_KEY=replace-with-a-long-random-production-key
PORT=8080
