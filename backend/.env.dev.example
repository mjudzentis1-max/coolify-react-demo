SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://<development-postgres-host>:5432/<development-database>
SPRING_DATASOURCE_USERNAME=<development-postgres-user>
SPRING_DATASOURCE_PASSWORD=<development-postgres-password>
FORMA_API_KEY=replace-with-a-long-random-development-key
PORT=8080
